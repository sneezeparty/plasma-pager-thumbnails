+/**
+ * Tells the pager which wallpaper each screen shows on each virtual desktop, by
+ * reading the desktop containments' wallpaper configuration.
+ *
+ * The desktop background is a single window that is on every virtual desktop, so
+ * a wallpaper that differs per desktop can't be seen in the windows of a desktop
+ * that isn't the current one; the pager has to draw the image itself.
+ */
+class DesktopWallpapers : public QObject
+{
+    Q_OBJECT
+    QML_ELEMENT
+
+    /** Changes whenever any of the answers below may have changed. */
+    Q_PROPERTY(int revision READ revision NOTIFY revisionChanged)
+
+public:
+    explicit DesktopWallpapers(QObject *parent = nullptr);
+
+    int revision() const;
+
+    /** Whether the wallpaper of the screen is of a kind whose image is known. */
+    Q_INVOKABLE bool known(const QString &screenName) const;
+    /** The image the screen shows on the virtual desktop, empty if there is none. */
+    Q_INVOKABLE QUrl image(const QString &screenName, const QString &desktopId) const;
+    /** The QtQuick Image.fillMode the wallpaper uses on the screen. */
+    Q_INVOKABLE int fillMode(const QString &screenName) const;
+    /** The colour behind images that don't cover the screen. */
+    Q_INVOKABLE QColor color(const QString &screenName) const;
+
+Q_SIGNALS:
+    void revisionChanged();
+
+private:
+    struct Screen {
+        QHash<QString, QUrl> images; // by virtual desktop id
+        QUrl image; // for every desktop without an entry above
+        int fillMode = 2;
+        QColor color = Qt::black;
+    };
+
+    void reload();
+    void watch();
+
+    QHash<QString, Screen> m_screens; // by connector name
+    QFileSystemWatcher m_watcher;
+    QTimer m_reloadTimer;
+    TaskManager::ActivityInfo *const m_activityInfo;
+    int m_revision = 0;
+};
