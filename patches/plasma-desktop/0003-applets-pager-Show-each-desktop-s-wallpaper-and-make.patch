new file mode 100644
index 0000000000..dca48c3928
--- /dev/null
+++ b/applets/pager/desktopwallpapers.cpp
@@ -0,0 +1,187 @@
+/*
+    SPDX-FileCopyrightText: 2026 sneezeparty <38020091+sneezeparty@users.noreply.github.com>
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "desktopwallpapers.h"
+
+#include <activityinfo.h>
+
+#include <KConfig>
+#include <KConfigGroup>
+
+#include <QDir>
+#include <QFileInfo>
+#include <QGuiApplication>
+#include <QRegularExpression>
+#include <QScreen>
+#include <QStandardPaths>
+
+using namespace Qt::StringLiterals;
+
+static QString configPath(const QString &name)
+{
+    return QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation) + u'/' + name;
+}
+
+static const QString s_appletsrc = u"plasma-org.kde.plasma.desktop-appletsrc"_s;
+static const QString s_shellrc = u"plasmashellrc"_s;
+static const QString s_perDesktopPlugin = u"com.github.sneezeparty.desktopwallpapers"_s;
+static const QString s_imagePlugin = u"org.kde.image"_s;
+
+// A wallpaper package is a folder with one image per resolution in contents/images,
+// named <width>x<height>.<ext>. Take the largest.
+static QUrl resolvePackage(const QUrl &url)
+{
+    const QFileInfo info(url.toLocalFile());
+    if (!info.isDir()) {
+        return url;
+    }
+
+    const QDir images(info.absoluteFilePath() + u"/contents/images"_s);
+    static const QRegularExpression size(u"^(\\d+)x(\\d+)\\."_s);
+    QString best;
+    qint64 bestArea = -1;
+    const auto entries = images.entryInfoList(QDir::Files);
+    for (const QFileInfo &entry : entries) {
+        const auto match = size.match(entry.fileName());
+        const qint64 area = match.hasMatch() ? match.captured(1).toLongLong() * match.captured(2).toLongLong() : 0;
+        if (area > bestArea) {
+            bestArea = area;
+            best = entry.absoluteFilePath();
+        }
+    }
+    return best.isEmpty() ? QUrl() : QUrl::fromLocalFile(best);
+}
+
+DesktopWallpapers::DesktopWallpapers(QObject *parent)
+    : QObject(parent)
+    , m_activityInfo(new TaskManager::ActivityInfo(this))
+{
+    // The files are rewritten, not edited in place, and often several times in a row.
+    m_reloadTimer.setSingleShot(true);
+    m_reloadTimer.setInterval(250);
+    connect(&m_reloadTimer, &QTimer::timeout, this, &DesktopWallpapers::reload);
+    connect(&m_watcher, &QFileSystemWatcher::fileChanged, &m_reloadTimer, qOverload<>(&QTimer::start));
+    connect(&m_watcher, &QFileSystemWatcher::directoryChanged, &m_reloadTimer, qOverload<>(&QTimer::start));
+    connect(m_activityInfo, &TaskManager::ActivityInfo::currentActivityChanged, this, &DesktopWallpapers::reload);
+
+    m_watcher.addPath(QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation));
+    connect(qGuiApp, &QGuiApplication::screenAdded, this, &DesktopWallpapers::reload);
+    connect(qGuiApp, &QGuiApplication::screenRemoved, this, &DesktopWallpapers::reload);
+    connect(qGuiApp, &QGuiApplication::primaryScreenChanged, this, &DesktopWallpapers::reload);
+    reload();
+}
+
+void DesktopWallpapers::watch()
+{
+    // A file that was replaced has to be added again.
+    for (const QString &name : {s_appletsrc, s_shellrc}) {
+        const QString path = configPath(name);
+        if (QFileInfo::exists(path) && !m_watcher.files().contains(path)) {
+            m_watcher.addPath(path);
+        }
+    }
+}
+
+void DesktopWallpapers::reload()
+{
+    watch();
+
+    // Plasma numbers the screens; the names are in plasmashellrc.
+    QHash<QString, QString> connectors;
+    {
+        const KConfig shellrc(configPath(s_shellrc), KConfig::SimpleConfig);
+        const KConfigGroup group = shellrc.group(u"ScreenConnectors"_s);
+        const auto keys = group.keyList();
+        for (const QString &key : keys) {
+            connectors.insert(key, group.readEntry(key, QString()));
+        }
+    }
+    if (connectors.isEmpty()) {
+        // Nothing saved yet, as in a brand new session: Plasma numbers the primary screen first.
+        QList<QScreen *> screens = QGuiApplication::screens();
+        screens.removeOne(QGuiApplication::primaryScreen());
+        screens.prepend(QGuiApplication::primaryScreen());
+        for (qsizetype i = 0; i < screens.size(); ++i) {
+            connectors.insert(QString::number(i), screens.at(i)->name());
+        }
+    }
+
+    QHash<QString, Screen> screens;
+    const KConfig appletsrc(configPath(s_appletsrc), KConfig::SimpleConfig);
+    const KConfigGroup containments = appletsrc.group(u"Containments"_s);
+    const QString activity = m_activityInfo->currentActivity();
+    const auto ids = containments.groupList();
+    for (const QString &id : ids) {
+        const KConfigGroup containment = containments.group(id);
+        const QString connector = connectors.value(containment.readEntry("lastScreen", u"-1"_s));
+        if (connector.isEmpty() || !containment.hasKey("wallpaperplugin")) {
+            continue;
+        }
+        // Desktops belong to an activity; panels and the system tray don't, but carry the same keys.
+        const QString containmentActivity = containment.readEntry("activityId", QString());
+        if (containmentActivity.isEmpty() || (!activity.isEmpty() && containmentActivity != activity)) {
+            continue;
+        }
+
+        const QString plugin = containment.readEntry("wallpaperplugin", QString());
+        const KConfigGroup general = containment.group(u"Wallpaper"_s).group(plugin).group(u"General"_s);
+        Screen screen;
+        screen.fillMode = general.readEntry("FillMode", 2);
+        screen.color = general.readEntry("Color", QColor(Qt::black));
+        if (plugin == s_perDesktopPlugin) {
+            const auto entries = general.readEntry("CurrentImages", QStringList());
+            for (const QString &entry : entries) {
+                const qsizetype at = entry.indexOf(u'=');
+                if (at > 0) {
+                    screen.images.insert(entry.left(at), QUrl(entry.mid(at + 1)));
+                }
+            }
+        } else if (plugin == s_imagePlugin) {
+            screen.image = resolvePackage(QUrl(general.readEntry("Image", QString())));
+            if (screen.image.isEmpty()) {
+                continue;
+            }
+        } else {
+            // A slideshow, a picture of the day, an animated wallpaper: only its window knows.
+            continue;
+        }
+        screens.insert(connector, screen);
+    }
+
+    m_screens = screens;
+    ++m_revision;
+    Q_EMIT revisionChanged();
+}
+
+int DesktopWallpapers::revision() const
+{
+    return m_revision;
+}
+
+bool DesktopWallpapers::known(const QString &screenName) const
+{
+    return m_screens.contains(screenName);
+}
+
+QUrl DesktopWallpapers::image(const QString &screenName, const QString &desktopId) const
+{
+    const auto it = m_screens.constFind(screenName);
+    if (it == m_screens.constEnd()) {
+        return QUrl();
+    }
+    return it->images.value(desktopId, it->image);
+}
+
+int DesktopWallpapers::fillMode(const QString &screenName) const
+{
+    return m_screens.value(screenName).fillMode;
+}
+
+QColor DesktopWallpapers::color(const QString &screenName) const
+{
+    return m_screens.value(screenName).color;
+}
+
+#include "moc_desktopwallpapers.cpp"
