+void DesktopWallpapers::scheduleReload()
+{
+    if (!m_reloadTimer.isActive()) {
+        m_reloadTimer.start();
+    }
+}
+
+void DesktopWallpapers::scheduleForcedReload()
+{
+    m_forceReload = true;
+    scheduleReload();
+}
+
+static QString fingerprint()
+{
+    // Every program that saves its settings changes the directory; only these two files matter.
+    QString result;
+    for (const QString &name : {s_appletsrc, s_shellrc}) {
+        const QFileInfo info(configPath(name));
+        result += QString::number(info.lastModified().toMSecsSinceEpoch()) + u':' + QString::number(info.size()) + u';';
+    }
+    return result;
+}
+
+void DesktopWallpapers::reloadIfChanged()
+{
+    if (m_forceReload || fingerprint() != m_fingerprint) {
+        reload();
+    }
+}
+
 void DesktopWallpapers::watch()
 {
     // A file that was replaced has to be added again.
@@ -88,17 +124,19 @@ void DesktopWallpapers::watch()
 void DesktopWallpapers::reload()
 {
     watch();
+    m_forceReload = false;
+    m_fingerprint = fingerprint();
 
     // Plasma numbers the screens, in an order of its own. The shell knows it.
-    QHash<QString, QString> connectors;
+    QMultiHash<QString, QString> connectors;
     if (m_corona) {
         const auto screens = QGuiApplication::screens();
         for (int id = 0; id < m_corona->numScreens(); ++id) {
             const QRect geometry = m_corona->screenGeometry(id);
             for (const QScreen *screen : screens) {
+                // More than one if the screens are mirrored
                 if (screen->geometry() == geometry) {
                     connectors.insert(QString::number(id), screen->name());
-                    break;
                 }
             }
         }
@@ -129,8 +167,8 @@ void DesktopWallpapers::reload()
     const auto ids = containments.groupList();
     for (const QString &id : ids) {
