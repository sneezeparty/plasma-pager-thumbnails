-        const QString connector = connectors.value(containment.readEntry("lastScreen", u"-1"_s));
-        if (connector.isEmpty() || !containment.hasKey("wallpaperplugin")) {
+        const QStringList names = connectors.values(containment.readEntry("lastScreen", u"-1"_s));
+        if (names.isEmpty() || !containment.hasKey("wallpaperplugin")) {
             continue;
         }
         // Desktops belong to an activity; panels and the system tray don't, but carry the same keys.
@@ -161,9 +199,14 @@ void DesktopWallpapers::reload()
             // A slideshow, a picture of the day, an animated wallpaper: only its window knows.
             continue;
         }
-        screens.insert(connector, screen);
+        for (const QString &name : names) {
+            screens.insert(name, screen);
+        }
     }
 
+    if (m_screens == screens && m_revision > 0) {
+        return;
+    }
     m_screens = screens;
     ++m_revision;
     Q_EMIT revisionChanged();
@@ -186,9 +229,9 @@ void DesktopWallpapers::setCorona(QObject *corona)
     m_corona = shell;
     if (m_corona) {
         // Screens get renumbered when one is added, removed or made the primary one.
-        connect(m_corona, &Plasma::Corona::screenAdded, &m_reloadTimer, qOverload<>(&QTimer::start));
-        connect(m_corona, &Plasma::Corona::screenRemoved, &m_reloadTimer, qOverload<>(&QTimer::start));
-        connect(m_corona, &Plasma::Corona::screenGeometryChanged, &m_reloadTimer, qOverload<>(&QTimer::start));
+        connect(m_corona, &Plasma::Corona::screenAdded, this, &DesktopWallpapers::scheduleForcedReload);
+        connect(m_corona, &Plasma::Corona::screenRemoved, this, &DesktopWallpapers::scheduleForcedReload);
+        connect(m_corona, &Plasma::Corona::screenGeometryChanged, this, &DesktopWallpapers::scheduleForcedReload);
     }
     Q_EMIT coronaChanged();
     reload();
@@ -223,4 +266,21 @@ QColor DesktopWallpapers::color(const QString &screenName) const
     return m_screens.value(screenName).color;
 }
 
+QSize DesktopWallpapers::imageSize(const QUrl &image)
+{
+    if (!image.isLocalFile()) {
+        return QSize();
+    }
+    const QString path = image.toLocalFile();
+    auto it = m_imageSizes.constFind(path);
+    if (it == m_imageSizes.constEnd()) {
+        if (m_imageSizes.size() > 64) {
+            m_imageSizes.clear();
+        }
+        // Reads the header only
+        it = m_imageSizes.insert(path, QImageReader(path).size());
+    }
+    return *it;
+}
