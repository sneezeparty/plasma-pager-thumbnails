+++ b/src/scripting/desktopwallpapers.h
@@ -0,0 +1,71 @@
+/*
+    SPDX-FileCopyrightText: 2026 sneezeparty <38020091+sneezeparty@users.noreply.github.com>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#pragma once
+
+#include <QColor>
+#include <QFileSystemWatcher>
+#include <QHash>
+#include <QObject>
+#include <QTimer>
+#include <QUrl>
+
+namespace KWin
+{
+
+class LogicalOutput;
+class VirtualDesktop;
+
+/**
+ * Knows the wallpaper of each virtual desktop on each output, for wallpapers that
+ * differ per virtual desktop.
+ *
+ * The desktop background is a single window that is on all virtual desktops, so
+ * such a wallpaper can only be seen in it for the current desktop. Whatever shows
+ * another desktop's background has to draw the image itself; this reads which one
+ * from the configuration of Plasma's desktop containments.
+ */
+class DesktopWallpapers : public QObject
+{
+    Q_OBJECT
+
+public:
+    struct Wallpaper {
+        QUrl image;
+        int fillMode = 2; // QQuickImage::PreserveAspectCrop
+        QColor color = Qt::black;
+
+        bool isValid() const
+        {
+            return !image.isEmpty();
+        }
+    };
+
+    static DesktopWallpapers *self();
+
+    Wallpaper wallpaper(const LogicalOutput *output, const VirtualDesktop *desktop, const QString &activity) const;
+
+Q_SIGNALS:
+    void changed();
+
+private:
+    explicit DesktopWallpapers();
+    void reload();
+
+    struct Screen {
+        int index = -1; // Plasma's number for the screen, the position in the output order
+        QString activity;
+        QHash<QString, QUrl> images; // by virtual desktop id
+        int fillMode = 2;
+        QColor color = Qt::black;
+    };
+
+    QList<Screen> m_screens;
+    QFileSystemWatcher m_watcher;
+    QTimer m_reloadTimer;
+};
+
+} // namespace KWin
