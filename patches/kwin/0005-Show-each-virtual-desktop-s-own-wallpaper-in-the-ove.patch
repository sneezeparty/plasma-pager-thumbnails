 src/plugins/overview/qml/DesktopView.qml |  30 +++++-
 src/plugins/overview/qml/Main.qml        |  26 ++++-
 src/scripting/desktopbackgrounditem.cpp  |  43 ++++++++
 src/scripting/desktopbackgrounditem.h    |  30 ++++++
