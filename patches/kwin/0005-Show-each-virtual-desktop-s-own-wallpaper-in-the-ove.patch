diff --git a/src/scripting/desktopwallpapers.cpp b/src/scripting/desktopwallpapers.cpp
new file mode 100644
index 0000000000..d2d10ba9ee
--- /dev/null
+++ b/src/scripting/desktopwallpapers.cpp
@@ -0,0 +1,119 @@
+/*
+    SPDX-FileCopyrightText: 2026 sneezeparty <38020091+sneezeparty@users.noreply.github.com>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "desktopwallpapers.h"
+#include "core/output.h"
+#include "virtualdesktops.h"
+#include "workspace.h"
+
+#include <KConfig>
+#include <KConfigGroup>
+
+#include <QFileInfo>
+#include <QStandardPaths>
+
+namespace KWin
+{
+
+static const QString s_perDesktopPlugin = QStringLiteral("com.github.sneezeparty.desktopwallpapers");
+
+static QString configDir()
+{
+    return QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation);
+}
+
+static QString appletsrc()
+{
+    return configDir() + QStringLiteral("/plasma-org.kde.plasma.desktop-appletsrc");
+}
+
+DesktopWallpapers *DesktopWallpapers::self()
+{
+    static DesktopWallpapers *s_self = new DesktopWallpapers();
+    return s_self;
+}
+
+DesktopWallpapers::DesktopWallpapers()
+{
+    // The file is rewritten, not edited in place, and often several times in a row.
+    m_reloadTimer.setSingleShot(true);
+    m_reloadTimer.setInterval(250);
+    connect(&m_reloadTimer, &QTimer::timeout, this, &DesktopWallpapers::reload);
+    connect(&m_watcher, &QFileSystemWatcher::fileChanged, &m_reloadTimer, qOverload<>(&QTimer::start));
+    connect(&m_watcher, &QFileSystemWatcher::directoryChanged, &m_reloadTimer, qOverload<>(&QTimer::start));
+    m_watcher.addPath(configDir());
+    connect(workspace(), &Workspace::outputOrderChanged, this, &DesktopWallpapers::changed);
+    reload();
+}
+
+void DesktopWallpapers::reload()
+{
+    // A file that was replaced has to be added again.
+    if (QFileInfo::exists(appletsrc()) && !m_watcher.files().contains(appletsrc())) {
+        m_watcher.addPath(appletsrc());
+    }
+
+    QList<Screen> screens;
+    const KConfig config(appletsrc(), KConfig::SimpleConfig);
+    const KConfigGroup containments = config.group(QStringLiteral("Containments"));
+    const auto ids = containments.groupList();
+    for (const QString &id : ids) {
+        const KConfigGroup containment = containments.group(id);
+        if (containment.readEntry("wallpaperplugin", QString()) != s_perDesktopPlugin) {
+            continue;
+        }
+        // Desktops belong to an activity; panels carry the same keys but have none.
+        Screen screen;
+        screen.activity = containment.readEntry("activityId", QString());
+        screen.index = containment.readEntry("lastScreen", -1);
+        if (screen.activity.isEmpty() || screen.index < 0) {
+            continue;
+        }
+
+        const KConfigGroup general = containment.group(QStringLiteral("Wallpaper")).group(s_perDesktopPlugin).group(QStringLiteral("General"));
+        screen.fillMode = general.readEntry("FillMode", 2);
+        const QStringList color = general.readEntry("Color", QStringList());
+        if (color.size() >= 3) {
+            screen.color = QColor(color[0].toInt(), color[1].toInt(), color[2].toInt());
+        }
+        const auto entries = general.readEntry("CurrentImages", QStringList());
+        for (const QString &entry : entries) {
+            const qsizetype at = entry.indexOf(QLatin1Char('='));
+            if (at > 0) {
+                screen.images.insert(entry.left(at), QUrl(entry.mid(at + 1)));
+            }
+        }
+        screens.append(screen);
+    }
+
+    m_screens = screens;
+    Q_EMIT changed();
+}
+
+DesktopWallpapers::Wallpaper DesktopWallpapers::wallpaper(const LogicalOutput *output, const VirtualDesktop *desktop, const QString &activity) const
+{
+    if (!output || !desktop) {
+        return Wallpaper();
+    }
+
+    // Plasma numbers the screens in the order of the outputs' priority.
+    const int index = workspace()->outputOrder().indexOf(const_cast<LogicalOutput *>(output));
+    for (const Screen &screen : m_screens) {
+        if (screen.index != index || (!activity.isEmpty() && screen.activity != activity)) {
+            continue;
+        }
+        return Wallpaper{
+            .image = screen.images.value(desktop->id()),
+            .fillMode = screen.fillMode,
+            .color = screen.color,
+        };
+    }
+    return Wallpaper();
+}
+
+} // namespace KWin
+
+#include "moc_desktopwallpapers.cpp"
