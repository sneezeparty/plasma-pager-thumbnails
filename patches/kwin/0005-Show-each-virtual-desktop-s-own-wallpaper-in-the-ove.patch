diff --git a/src/plugins/overview/qml/DesktopView.qml b/src/plugins/overview/qml/DesktopView.qml
index bf5a5f0092..be8b5499d8 100644
--- a/src/plugins/overview/qml/DesktopView.qml
+++ b/src/plugins/overview/qml/DesktopView.qml
@@ -13,6 +13,33 @@ Item {
     required property QtObject windowModel
     required property QtObject desktop
 
+    // Tells which image is this desktop's wallpaper when the desktop window shows another one
+    KWinComponents.DesktopBackground {
+        id: background
+        activity: KWinComponents.Workspace.currentActivity
+        desktop: desktopView.desktop
+        outputName: targetScreen.name
+        visible: false
+    }
+
+    Rectangle {
+        anchors.fill: parent
+        z: -1 // Below every window
+        visible: wallpaperImage.status === Image.Ready
+        color: background.wallpaperColor
+
+        Image {
+            id: wallpaperImage
+            anchors.fill: parent
+            source: background.wallpaper
+            fillMode: background.wallpaperFillMode
+            // These are small; the desktop bar shows one per desktop
+            sourceSize: Qt.size(Math.round(targetScreen.geometry.width / 4), Math.round(targetScreen.geometry.height / 4))
+            asynchronous: true
+            cache: true
+        }
+    }
+
     Repeater {
         model: KWinComponents.WindowFilterModel {
             activity: KWinComponents.Workspace.currentActivity
@@ -28,7 +55,8 @@ Item {
             width: model.window.width
             height: model.window.height
             z: model.window.stackingOrder
-            visible: !model.window.minimized
+            // The desktop window gives way to this desktop's own wallpaper
+            visible: !model.window.minimized && !(model.window.desktopWindow && wallpaperImage.status === Image.Ready)
         }
     }
 }
diff --git a/src/plugins/overview/qml/Main.qml b/src/plugins/overview/qml/Main.qml
index 209d63131c..19a95efcfc 100644
--- a/src/plugins/overview/qml/Main.qml
+++ b/src/plugins/overview/qml/Main.qml
@@ -566,16 +566,38 @@ FocusScope {
                         anchors.fill: parent
                         anchors.margins: gridVal !== 0 ? Math.round(mainBackground.current * gridVal * (1.5 / gridScale.xScale)) : 0
                         activity: KWinComponents.Workspace.currentActivity
-                        desktop: currentDesktop
+                        // The desktop window is the same for every desktop, but its wallpaper may not be
+                        desktop: mainBackground.desktop
                         outputName: targetScreen.name
                         visible: false
                     }
 
+                    // A wallpaper that differs per virtual desktop can't be seen in the desktop
+                    // window unless the desktop is the current one; shown from its image instead.
+                    Rectangle {
+                        id: desktopWallpaper
+                        anchors.fill: desktopElement
+                        visible: false
+                        // Keep showing the window until the image is there, rather than a blank
+                        layer.enabled: wallpaperImage.status === Image.Ready
+                        color: desktopElement.wallpaperColor
+
+                        Image {
+                            id: wallpaperImage
+                            anchors.fill: parent
+                            source: desktopElement.wallpaper
+                            fillMode: desktopElement.wallpaperFillMode
+                            sourceSize: Qt.size(targetScreen.geometry.width, targetScreen.geometry.height)
+                            asynchronous: true
+                            cache: true
+                        }
+                    }
+
                     Kirigami.ShadowedTexture {
                         anchors.fill: parent
 
                         color: "transparent"
-                        source: desktopElement
+                        source: desktopWallpaper.layer.enabled ? desktopWallpaper : desktopElement
 
                         radius: Kirigami.Units.cornerRadius * (overviewVal + gridVal * 2)
 
diff --git a/src/scripting/desktopbackgrounditem.cpp b/src/scripting/desktopbackgrounditem.cpp
index c774b420cf..d1679d0c3a 100644
--- a/src/scripting/desktopbackgrounditem.cpp
+++ b/src/scripting/desktopbackgrounditem.cpp
@@ -22,6 +22,23 @@ namespace KWin
 DesktopBackgroundItem::DesktopBackgroundItem(QQuickItem *parent)
     : WindowThumbnailItem(parent)
 {
+    connect(DesktopWallpapers::self(), &DesktopWallpapers::changed, this, &DesktopBackgroundItem::updateWallpaper);
+    connect(VirtualDesktopManager::self(), &VirtualDesktopManager::currentChanged, this, &DesktopBackgroundItem::updateWallpaper);
+}
+
+QUrl DesktopBackgroundItem::wallpaper() const
+{
+    return m_wallpaper.image;
+}
+
+int DesktopBackgroundItem::wallpaperFillMode() const
+{
+    return m_wallpaper.fillMode;
+}
+
+QColor DesktopBackgroundItem::wallpaperColor() const
+{
+    return m_wallpaper.color;
 }
 
 void DesktopBackgroundItem::componentComplete()
@@ -119,6 +136,32 @@ void DesktopBackgroundItem::updateWindow()
     }
 
     setClient(clientCandidate);
+    updateWallpaper();
+}
+
+void DesktopBackgroundItem::updateWallpaper()
+{
+    if (!isComponentComplete()) {
+        return;
+    }
+
+    // The desktop window shows the wallpaper of the current desktop. Asked for another
+    // desktop, say which image belongs there, if one is known.
+    DesktopWallpapers::Wallpaper wallpaper;
+    if (m_output && m_desktop && m_desktop != VirtualDesktopManager::self()->currentDesktop(m_output)) {
+        QString activity = m_activity;
+#if KWIN_BUILD_ACTIVITIES
+        if (activity.isEmpty() && Workspace::self()->activities()) {
+            activity = Workspace::self()->activities()->current();
+        }
+#endif
+        wallpaper = DesktopWallpapers::self()->wallpaper(m_output, m_desktop, activity);
+    }
+
+    if (m_wallpaper.image != wallpaper.image || m_wallpaper.fillMode != wallpaper.fillMode || m_wallpaper.color != wallpaper.color) {
+        m_wallpaper = wallpaper;
+        Q_EMIT wallpaperChanged();
+    }
 }
 
 } // namespace KWin
