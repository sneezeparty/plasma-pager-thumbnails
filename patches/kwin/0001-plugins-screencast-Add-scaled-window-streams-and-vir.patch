+#pragma once
+
+#include "core/rect.h"
+#include "screencastsource.h"
+
+#include <QPointer>
+#include <QSize>
+
+namespace KWin
+{
+
+class LogicalOutput;
+class VirtualDesktop;
+class Window;
+
+/**
+ * Streams the windows of a virtual desktop, scaled down to fit inside a given
+ * size, whether or not the desktop is the one currently shown.
+ *
+ * The scene only contains the windows of the current desktop, so rather than
+ * painting a view of the scene, the windows are painted one by one in stacking
+ * order, like WindowScreenCastSource does for a window and its popups.
+ */
+class DesktopScreenCastSource : public ScreenCastSource
+{
+    Q_OBJECT
+
+public:
+    /**
+     * If @p output is null, the stream covers the whole workspace.
+     */
+    explicit DesktopScreenCastSource(VirtualDesktop *desktop, LogicalOutput *output, const QSize &maxSize);
+    ~DesktopScreenCastSource() override;
+
+    quint32 drmFormat() const override;
+    QSize textureSize() const override;
+    qreal devicePixelRatio() const override;
+    uint refreshRate() const override;
+
+    void setRenderCursor(bool enable) override;
+    Region render(GLFramebuffer *target, const Region &bufferDamage) override;
+    Region render(QImage *target, const Region &bufferDamage) override;
+    std::chrono::nanoseconds clock() const override;
+
+    void resume() override;
+    void pause() override;
+
+    bool includesCursor(Cursor *cursor) const override;
+
+    QPointF mapFromGlobal(const QPointF &point) const override;
+    RectF mapFromGlobal(const RectF &rect) const override;
+
+private:
+    void track(Window *window);
+    void watch(Window *window);
+    void unwatch(Window *window);
+    void updateWindows();
+    bool accepts(const Window *window) const;
+    bool isCurrent() const;
+    RectF boundingRect() const;
+    void close();
+
+    const QPointer<VirtualDesktop> m_desktop;
+    const QPointer<LogicalOutput> m_output;
+    const bool m_wholeWorkspace;
+    const QSize m_maxSize;
+    // The windows shown in the stream, in stacking order
+    QList<Window *> m_windows;
+    std::chrono::nanoseconds m_last{0};
+    bool m_closed = false;
+    bool m_active = false;
+    bool m_renderCursor = false;
+};
+
+} // namespace KWin
