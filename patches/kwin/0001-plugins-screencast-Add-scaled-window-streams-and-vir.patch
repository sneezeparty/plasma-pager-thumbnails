+// Scaled streams are meant for thumbnails, don't let them be used as a way to
+// get the full contents.
+static QSize clampScaledSize(const QSize &size)
+{
+    static const int s_maxEdge = 512;
+    if (size.width() <= s_maxEdge && size.height() <= s_maxEdge) {
+        return size;
+    }
+    return size.scaled(s_maxEdge, s_maxEdge, Qt::KeepAspectRatio).expandedTo(QSize(1, 1));
+}
+
 void ScreencastManager::streamWindow(ScreencastStreamV1Interface *waylandStream,
                                      const QString &winid,
+                                     const QSize &maxSize,
                                      ScreencastV1Interface::CursorMode mode)
 {
     if (!isSupportedCompositingType()) {
@@ -63,13 +78,59 @@ void ScreencastManager::streamWindow(ScreencastStreamV1Interface *waylandStream,
         return;
     }
 
-    auto stream = new ScreenCastStream(new WindowScreenCastSource(window), getPipewireConnection(), this);
+    // An invalid size means a regular stream_window request, a scaled one can't be empty.
+    if (maxSize.isValid() && maxSize.isEmpty()) {
+        waylandStream->sendFailed(i18n("Invalid size"));
+        return;
+    }
+
+    auto source = new WindowScreenCastSource(window, maxSize.isValid() ? clampScaledSize(maxSize) : QSize());
+    auto stream = new ScreenCastStream(source, getPipewireConnection(), this);
     stream->setObjectName(window->desktopFileName());
     stream->setCursorMode(mode);
 
     integrateStreams(waylandStream, stream);
 }
 
+void ScreencastManager::streamDesktop(ScreencastStreamV1Interface *waylandStream,
+                                      const QString &desktopId,
+                                      OutputInterface *output,
+                                      const QSize &maxSize,
+                                      ScreencastV1Interface::CursorMode mode)
+{
+    if (!isSupportedCompositingType()) {
+        waylandStream->sendFailed(i18n("Unsupported compositing type"));
+        return;
+    }
+
+    VirtualDesktop *desktop = VirtualDesktopManager::self()->desktopForId(desktopId);
+    if (!desktop) {
+        waylandStream->sendFailed(i18n("Could not find virtual desktop id %1", desktopId));
+        return;
+    }
+
+    if (maxSize.isEmpty()) {
+        waylandStream->sendFailed(i18n("Invalid size"));
+        return;
+    }
+
+    LogicalOutput *logicalOutput = nullptr;
+    if (output) {
+        logicalOutput = output->handle();
+        if (!logicalOutput) {
+            waylandStream->sendFailed(i18n("Could not find output"));
+            return;
+        }
+    }
+
+    auto source = new DesktopScreenCastSource(desktop, logicalOutput, clampScaledSize(maxSize));
+    auto stream = new ScreenCastStream(source, getPipewireConnection(), this);
+    stream->setObjectName(desktop->name());
+    stream->setCursorMode(mode);
+
+    integrateStreams(waylandStream, stream);
+}
