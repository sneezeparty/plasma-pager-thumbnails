+#include "desktopscreencastsource.h"
+#include "screencastutils.h"
+
+#include "compositor.h"
+#include "core/output.h"
+#include "core/rendertarget.h"
+#include "core/renderviewport.h"
+#include "cursor.h"
+#include "effect/effect.h"
+#include "opengl/glframebuffer.h"
+#include "opengl/gltexture.h"
+#include "scene/itemrenderer.h"
+#include "scene/windowitem.h"
+#include "scene/workspacescene.h"
+#include "virtualdesktops.h"
+#include "wayland_server.h"
+#include "window.h"
+#include "workspace.h"
+
+#include <drm_fourcc.h>
+
+namespace KWin
+{
+
+// Desktop streams are thumbnails, there is no point in keeping up with the display.
+static const uint s_maxRefreshRate = 15000;
+
+DesktopScreenCastSource::DesktopScreenCastSource(VirtualDesktop *desktop, LogicalOutput *output, const QSize &maxSize)
+    : ScreenCastSource()
+    , m_desktop(desktop)
+    , m_output(output)
+    , m_wholeWorkspace(!output)
+    , m_maxSize(maxSize)
+{
+    Q_ASSERT(desktop);
+    Q_ASSERT(!m_maxSize.isEmpty());
+
+    connect(desktop, &VirtualDesktop::aboutToBeDestroyed, this, &DesktopScreenCastSource::close);
+    connect(workspace(), &Workspace::outputRemoved, this, [this](LogicalOutput *output) {
+        if (!m_wholeWorkspace && (!m_output || m_output == output)) {
+            close();
+        }
+    });
+
+    connect(workspace(), &Workspace::windowAdded, this, [this](Window *window) {
+        track(window);
+        updateWindows();
+    });
+    connect(workspace(), &Workspace::stackingOrderChanged, this, &DesktopScreenCastSource::updateWindows);
+    connect(workspace(), &Workspace::currentActivityChanged, this, &DesktopScreenCastSource::updateWindows);
+    connect(workspace(), &Workspace::geometryChanged, this, &DesktopScreenCastSource::updateWindows);
+    connect(waylandServer(), &WaylandServer::lockStateChanged, this, &DesktopScreenCastSource::updateWindows);
+
+    const auto windows = workspace()->windows();
+    for (Window *window : windows) {
+        track(window);
+    }
+    updateWindows();
+}
+
+DesktopScreenCastSource::~DesktopScreenCastSource()
+{
+    pause();
+}
+
+void DesktopScreenCastSource::close()
+{
+    if (!m_closed) {
+        m_closed = true;
+        Q_EMIT closed();
+    }
+}
+
+void DesktopScreenCastSource::track(Window *window)
+{
+    connect(window, &Window::closed, this, [this, window] {
+        if (m_windows.removeOne(window)) {
+            if (m_active) {
+                unwatch(window);
+                Q_EMIT frame();
+            }
+        }
+    });
+    connect(window, &Window::desktopsChanged, this, &DesktopScreenCastSource::updateWindows);
+    connect(window, &Window::activitiesChanged, this, &DesktopScreenCastSource::updateWindows);
+    connect(window, &Window::minimizedChanged, this, &DesktopScreenCastSource::updateWindows);
+    connect(window, &Window::hiddenChanged, this, &DesktopScreenCastSource::updateWindows);
+    connect(window, &Window::readyForPaintingChanged, this, &DesktopScreenCastSource::updateWindows);
+    connect(window, &Window::excludeFromCaptureChanged, this, &DesktopScreenCastSource::updateWindows);
+    connect(window, &Window::frameGeometryChanged, this, &DesktopScreenCastSource::updateWindows);
+}
+
+bool DesktopScreenCastSource::accepts(const Window *window) const
+{
+    if (!m_desktop || window->isDeleted() || !window->readyForPainting() || !window->windowItem()) {
+        return false;
+    }
+    if (window->isMinimized() || window->isHidden() || window->excludeFromCapture()) {
+        return false;
+    }
+    if (!window->isOnDesktop(m_desktop) || !window->isOnCurrentActivity()) {
+        return false;
+    }
+    return window->visibleGeometry().intersects(boundingRect());
+}
+
+void DesktopScreenCastSource::updateWindows()
+{
+    if (m_closed) {
+        return;
+    }
+
+    QList<Window *> windows;
+    if (!waylandServer()->isScreenLocked()) {
+        const auto stackingOrder = workspace()->stackingOrder();
+        for (Window *window : stackingOrder) {
+            if (accepts(window)) {
+                windows.append(window);
+            }
+        }
+    }
+
+    if (m_active) {
+        for (Window *window : std::as_const(windows)) {
+            if (!m_windows.contains(window)) {
+                watch(window);
+            }
+        }
+        for (Window *window : std::as_const(m_windows)) {
+            if (!windows.contains(window)) {
+                unwatch(window);
+            }
+        }
+    }
+    m_windows = windows;
+
+    if (m_active) {
+        Q_EMIT frame();
+    }
+}
+
+void DesktopScreenCastSource::watch(Window *window)
+{
+    window->refOffscreenRendering();
+    connect(window, &Window::damaged, this, &DesktopScreenCastSource::frame);
+}
+
+void DesktopScreenCastSource::unwatch(Window *window)
+{
+    window->unrefOffscreenRendering();
+    disconnect(window, &Window::damaged, this, &DesktopScreenCastSource::frame);
+}
+
+RectF DesktopScreenCastSource::boundingRect() const
+{
+    if (m_output) {
+        return m_output->geometryF();
+    }
+    return workspace()->geometry();
+}
+
+bool DesktopScreenCastSource::isCurrent() const
+{
+    const auto outputs = workspace()->outputs();
+    for (LogicalOutput *output : outputs) {
+        if (m_output && m_output != output) {
+            continue;
+        }
+        if (VirtualDesktopManager::self()->currentDesktop(output) == m_desktop) {
+            return true;
+        }
+    }
+    return false;
+}
+
+quint32 DesktopScreenCastSource::drmFormat() const
+{
+    return DRM_FORMAT_ARGB8888;
+}
+
+qreal DesktopScreenCastSource::devicePixelRatio() const
+{
+    const QSizeF size = boundingRect().size();
+    if (size.isEmpty()) {
+        return 1.0;
+    }
+
+    // Never scale up past the native resolution
+    qreal scale = 1.0;
+    const auto outputs = workspace()->outputs();
+    for (const LogicalOutput *output : outputs) {
+        if (output->geometryF().intersects(boundingRect())) {
+            scale = std::max(scale, output->scale());
+        }
+    }
+
+    return std::min({scale, m_maxSize.width() / size.width(), m_maxSize.height() / size.height()});
+}
+
+QSize DesktopScreenCastSource::textureSize() const
+{
+    return (boundingRect().size() * devicePixelRatio()).toSize().expandedTo(QSize(1, 1));
+}
+
+uint DesktopScreenCastSource::refreshRate() const
+{
+    uint ret = 0;
+    const auto outputs = workspace()->outputs();
+    for (const LogicalOutput *output : outputs) {
+        if (output->geometryF().intersects(boundingRect())) {
+            ret = std::max<uint>(ret, output->refreshRate());
+        }
+    }
+    return std::min(ret, s_maxRefreshRate);
+}
+
+void DesktopScreenCastSource::setRenderCursor(bool enable)
+{
+    m_renderCursor = enable;
+}
+
+Region DesktopScreenCastSource::render(QImage *target, const Region &bufferDamage)
+{
+    const auto offscreenTexture = GLTexture::allocate(GL_RGBA8, target->size());
+    if (!offscreenTexture) {
+        return Region{};
+    }
+    offscreenTexture->setContentTransform(OutputTransform::FlipY);
+
+    GLFramebuffer offscreenTarget(offscreenTexture.get());
+    render(&offscreenTarget, Region::infinite());
+    grabTexture(offscreenTexture.get(), target);
+    return Rect(QPoint(), target->size());
+}
+
+Region DesktopScreenCastSource::render(GLFramebuffer *target, const Region &bufferDamage)
+{
+    m_last = std::chrono::steady_clock::now().time_since_epoch();
+
+    RenderTarget renderTarget(target);
+    RenderViewport viewport(boundingRect(), devicePixelRatio(), renderTarget, QPoint());
+
+    WorkspaceScene *scene = kwinApp()->scene();
+
+    scene->renderer()->beginFrame(renderTarget, viewport);
+    glClearColor(0.0, 0.0, 0.0, 0.0);
+    glClear(GL_COLOR_BUFFER_BIT);
+    for (Window *window : std::as_const(m_windows)) {
+        scene->renderer()->renderItem(renderTarget, viewport, window->windowItem(), Scene::PAINT_WINDOW_TRANSFORMED, Region::infinite(), WindowPaintData{}, {}, {});
+    }
+    if (m_renderCursor && isCurrent() && scene->cursorItem()->isVisible()) {
+        scene->renderer()->renderItem(renderTarget, viewport, scene->cursorItem(), 0, Region::infinite(), WindowPaintData{}, {}, {});
+    }
+    scene->renderer()->endFrame();
+    return Rect(QPoint(), target->size());
+}
+
+std::chrono::nanoseconds DesktopScreenCastSource::clock() const
+{
+    return m_last;
+}
+
+void DesktopScreenCastSource::pause()
+{
+    if (!m_active) {
+        return;
+    }
+
+    for (Window *window : std::as_const(m_windows)) {
+        unwatch(window);
+    }
+    m_active = false;
+}
+
+void DesktopScreenCastSource::resume()
+{
+    if (m_active) {
+        return;
+    }
+
+    for (Window *window : std::as_const(m_windows)) {
+        watch(window);
+    }
+    m_active = true;
+
+    Q_EMIT frame();
+}
+
+bool DesktopScreenCastSource::includesCursor(Cursor *cursor) const
+{
+    if (Cursors::self()->isCursorHidden() || !isCurrent()) {
+        return false;
+    }
+
+    return boundingRect().intersects(cursor->geometry());
+}
+
+QPointF DesktopScreenCastSource::mapFromGlobal(const QPointF &point) const
+{
+    return point - boundingRect().topLeft();
+}
+
+RectF DesktopScreenCastSource::mapFromGlobal(const RectF &rect) const
+{
+    return rect.translated(-boundingRect().topLeft());
+}
+
+} // namespace KWin
+
+#include "moc_desktopscreencastsource.cpp"
