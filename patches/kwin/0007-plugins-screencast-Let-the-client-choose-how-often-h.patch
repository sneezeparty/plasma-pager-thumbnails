+    explicit DesktopScreenCastSource(VirtualDesktop *desktop, LogicalOutput *output, const QSize &maxSize, bool excludeBackground, uint hiddenRefreshRate);
     ~DesktopScreenCastSource() override;
 
     quint32 drmFormat() const override;
@@ -77,6 +78,7 @@ private:
     const bool m_wholeWorkspace;
     const QSize m_maxSize;
     const bool m_excludeBackground;
+    const std::chrono::milliseconds m_hiddenInterval;
     // The windows shown in the stream, in stacking order
     QList<Window *> m_windows;
     std::chrono::nanoseconds m_last{0};
diff --git a/src/plugins/screencast/screencastmanager.cpp b/src/plugins/screencast/screencastmanager.cpp
index f509d77164..53e272b596 100644
--- a/src/plugins/screencast/screencastmanager.cpp
+++ b/src/plugins/screencast/screencastmanager.cpp
@@ -97,6 +97,7 @@ void ScreencastManager::streamDesktop(ScreencastStreamV1Interface *waylandStream
                                       OutputInterface *output,
                                       const QSize &maxSize,
                                       bool excludeBackground,
+                                      uint hiddenRefreshRate,
                                       ScreencastV1Interface::CursorMode mode)
 {
     if (!isSupportedCompositingType()) {
@@ -124,7 +125,13 @@ void ScreencastManager::streamDesktop(ScreencastStreamV1Interface *waylandStream
         }
     }
 
-    auto source = new DesktopScreenCastSource(desktop, logicalOutput, clampScaledSize(maxSize), excludeBackground);
+    // Once a second keeps a thumbnail roughly up to date at next to no cost. More is the
+    // client's choice, up to a rate that is still plenty for something this small.
+    static const uint s_defaultHiddenRefreshRate = 1;
+    static const uint s_maxHiddenRefreshRate = 30;
+    const uint hiddenRate = hiddenRefreshRate == 0 ? s_defaultHiddenRefreshRate : std::min(hiddenRefreshRate, s_maxHiddenRefreshRate);
+
+    auto source = new DesktopScreenCastSource(desktop, logicalOutput, clampScaledSize(maxSize), excludeBackground, hiddenRate);
     auto stream = new ScreenCastStream(source, getPipewireConnection(), this);
     stream->setObjectName(desktop->name());
     stream->setCursorMode(mode);
