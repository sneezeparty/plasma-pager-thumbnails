diff --git a/src/window.cpp b/src/window.cpp
index 4d0dd84a38..053adb756a 100644
--- a/src/window.cpp
+++ b/src/window.cpp
@@ -4487,34 +4487,28 @@ void Window::unrefOffscreenRendering()
     updateOffscreenRendering(wasOffscreenRendering);
 }
 
-void Window::refThrottledOffscreenRendering()
+void Window::refThrottledOffscreenRendering(std::chrono::milliseconds interval)
 {
     const bool wasOffscreenRendering = isOffscreenRendering();
-    m_throttledOffscreenRenderCount++;
+    m_throttledOffscreenIntervals.append(std::max(interval, std::chrono::milliseconds(1)));
     updateOffscreenRendering(wasOffscreenRendering);
 }
 
-void Window::unrefThrottledOffscreenRendering()
+void Window::unrefThrottledOffscreenRendering(std::chrono::milliseconds interval)
 {
-    Q_ASSERT(m_throttledOffscreenRenderCount);
     const bool wasOffscreenRendering = isOffscreenRendering();
-    m_throttledOffscreenRenderCount--;
+    const bool removed = m_throttledOffscreenIntervals.removeOne(std::max(interval, std::chrono::milliseconds(1)));
+    Q_ASSERT(removed);
     updateOffscreenRendering(wasOffscreenRendering);
 }
 
-// TODO: temporary knob for measuring, to be replaced by a proper setting.
-static int throttledOffscreenInterval()
-{
-    static const int interval = qEnvironmentVariableIsSet("KWIN_THROTTLED_OFFSCREEN_INTERVAL") ? std::max(1, qEnvironmentVariableIntValue("KWIN_THROTTLED_OFFSCREEN_INTERVAL")) : 1000;
-    return interval;
-}
-
 void Window::updateOffscreenRendering(bool wasOffscreenRendering)
 {
     if (m_offscreenRenderCount > 0) {
         m_offscreenFramecallbackTimer.start(1'000'000 / output()->refreshRate());
-    } else if (m_throttledOffscreenRenderCount > 0) {
-        m_offscreenFramecallbackTimer.start(throttledOffscreenInterval());
+    } else if (!m_throttledOffscreenIntervals.isEmpty()) {
+        // Whoever wants it most often decides
+        m_offscreenFramecallbackTimer.start(*std::ranges::min_element(m_throttledOffscreenIntervals));
     } else {
         m_offscreenFramecallbackTimer.stop();
     }
@@ -4526,7 +4520,7 @@ void Window::updateOffscreenRendering(bool wasOffscreenRendering)
 
 bool Window::isOffscreenRendering() const
 {
-    return m_offscreenRenderCount > 0 || m_throttledOffscreenRenderCount > 0;
+    return m_offscreenRenderCount > 0 || !m_throttledOffscreenIntervals.isEmpty();
 }
 
 void Window::maybeSendFrameCallback()
