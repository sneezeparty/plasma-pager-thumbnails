 8 files changed, 37 insertions(+), 27 deletions(-)

diff --git a/src/plugins/screencast/desktopscreencastsource.cpp b/src/plugins/screencast/desktopscreencastsource.cpp
index 9ea362ab4f..ebad7f170a 100644
--- a/src/plugins/screencast/desktopscreencastsource.cpp
+++ b/src/plugins/screencast/desktopscreencastsource.cpp
@@ -31,13 +31,14 @@ namespace KWin
 // Desktop streams are thumbnails, there is no point in keeping up with the display.
 static const uint s_maxRefreshRate = 15000;
 
-DesktopScreenCastSource::DesktopScreenCastSource(VirtualDesktop *desktop, LogicalOutput *output, const QSize &maxSize, bool excludeBackground)
+DesktopScreenCastSource::DesktopScreenCastSource(VirtualDesktop *desktop, LogicalOutput *output, const QSize &maxSize, bool excludeBackground, uint hiddenRefreshRate)
     : ScreenCastSource()
     , m_desktop(desktop)
     , m_output(output)
     , m_wholeWorkspace(!output)
     , m_maxSize(maxSize)
     , m_excludeBackground(excludeBackground)
+    , m_hiddenInterval(1000 / std::max(1u, hiddenRefreshRate))
 {
     Q_ASSERT(desktop);
     Q_ASSERT(!m_maxSize.isEmpty());
@@ -231,14 +232,14 @@ void DesktopScreenCastSource::scheduleFrame()
 
 void DesktopScreenCastSource::watch(Window *window)
 {
-    // Windows on other desktops only need to be roughly up to date
-    window->refThrottledOffscreenRendering();
+    // Windows on other desktops only need to be as up to date as was asked for
+    window->refThrottledOffscreenRendering(m_hiddenInterval);
     connect(window, &Window::damaged, this, &DesktopScreenCastSource::scheduleFrame);
 }
 
 void DesktopScreenCastSource::unwatch(Window *window)
 {
-    window->unrefThrottledOffscreenRendering();
+    window->unrefThrottledOffscreenRendering(m_hiddenInterval);
     disconnect(window, &Window::damaged, this, &DesktopScreenCastSource::scheduleFrame);
 }
 
@@ -308,7 +309,9 @@ uint DesktopScreenCastSource::refreshRate() const
             ret = std::max<uint>(ret, output->refreshRate());
         }
     }
-    return std::min(ret, s_maxRefreshRate);
+    // No point in a stream slower than the windows it shows are asked to draw
+    const uint hiddenRate = 1'000'000 / std::max<int>(1, m_hiddenInterval.count());
+    return std::min(ret, std::max(s_maxRefreshRate, hiddenRate));
 }
 
 void DesktopScreenCastSource::setRenderCursor(bool enable)
