 src/plugins/screencast/screencastmanager.cpp  |  9 ++++++-
 src/plugins/screencast/screencastmanager.h    |  1 +
 src/wayland/screencast_v1.cpp                 |  3 ++-
 src/wayland/screencast_v1.h                   |  4 +++-
