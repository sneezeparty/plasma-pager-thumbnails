From 96d6a41dfd8725ede3dedad81ac8658c3e83854f Mon Sep 17 00:00:00 2001
From: sneezeparty <38020091+sneezeparty@users.noreply.github.com>
Date: Fri, 9 Oct 2026 06:04:35 -0700
Subject: [PATCH 4/8] plugins/screencast: Desktop streams with alpha and
 without the background

Desktop streams no longer offer a format without alpha, so areas no output covers are transparent, and the background can be left out for consumers that draw it themselves. Also adds a temporary environment knob for the hidden-window update interval, used for measuring.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/plugins/screencast/desktopscreencastsource.cpp | 14 +++++++++++++-
 src/plugins/screencast/desktopscreencastsource.h   |  4 +++-
 src/plugins/screencast/screencastmanager.cpp       |  3 ++-
 src/plugins/screencast/screencastmanager.h         |  1 +
 src/plugins/screencast/screencastsource.h          |  8 ++++++++
 src/plugins/screencast/screencaststream.cpp        |  4 +++-
 src/wayland/screencast_v1.cpp                      |  3 ++-
 src/wayland/screencast_v1.h                        |  2 +-
 src/window.cpp                                     |  9 +++++++--
 9 files changed, 40 insertions(+), 8 deletions(-)

diff --git a/src/plugins/screencast/desktopscreencastsource.cpp b/src/plugins/screencast/desktopscreencastsource.cpp
index ff4ac4b786..3c1e9d6e18 100644
--- a/src/plugins/screencast/desktopscreencastsource.cpp
+++ b/src/plugins/screencast/desktopscreencastsource.cpp
@@ -31,12 +31,13 @@ namespace KWin
 // Desktop streams are thumbnails, there is no point in keeping up with the display.
 static const uint s_maxRefreshRate = 15000;
 
-DesktopScreenCastSource::DesktopScreenCastSource(VirtualDesktop *desktop, LogicalOutput *output, const QSize &maxSize)
+DesktopScreenCastSource::DesktopScreenCastSource(VirtualDesktop *desktop, LogicalOutput *output, const QSize &maxSize, bool excludeBackground)
     : ScreenCastSource()
     , m_desktop(desktop)
     , m_output(output)
     , m_wholeWorkspace(!output)
     , m_maxSize(maxSize)
+    , m_excludeBackground(excludeBackground)
 {
     Q_ASSERT(desktop);
     Q_ASSERT(!m_maxSize.isEmpty());
@@ -112,6 +113,11 @@ bool DesktopScreenCastSource::accepts(const Window *window) const
     if (window->isDock()) {
         return false;
     }
+    // The consumer draws the background itself, for instance because it knows a
+    // different wallpaper for each desktop while there is only one desktop window.
+    if (m_excludeBackground && window->isDesktop()) {
+        return false;
+    }
     if (!window->isOnDesktop(m_desktop) || !window->isOnCurrentActivity()) {
         return false;
     }
@@ -201,6 +207,12 @@ bool DesktopScreenCastSource::isCurrent() const
     return false;
 }
 
+bool DesktopScreenCastSource::keepAlpha() const
+{
+    // Areas that no output covers, and the background if it is left out, are transparent.
+    return true;
+}
+
 quint32 DesktopScreenCastSource::drmFormat() const
 {
     return DRM_FORMAT_ARGB8888;
