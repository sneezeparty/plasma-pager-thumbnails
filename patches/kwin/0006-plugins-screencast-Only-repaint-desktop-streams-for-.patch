 bool DesktopScreenCastSource::isHeldBack() const
 {
-    // Stay out of the way of games and videos. Whoever shows the stream is most
-    // likely covered by the fullscreen window anyway.
+    // Stay out of the way of games and videos. With a single screen, whoever shows the
+    // stream is covered by the fullscreen window. With more of them it may well be on
+    // another one, and has to pause the stream itself when it can't be seen.
     const Window *active = workspace()->activeWindow();
-    return active && active->isFullScreen();
+    return active && active->isFullScreen() && workspace()->outputs().size() == 1;
+}
+
+void DesktopScreenCastSource::updateSuspended()
+{
+    // Nobody is looking with the screens off either
+    const bool suspended = isHeldBack() || workspace()->dpmsState() != Workspace::DpmsState::On;
+    if (m_suspended != suspended) {
+        m_suspended = suspended;
+        setWatching(m_active && !m_suspended);
+    }
+}
+
+void DesktopScreenCastSource::setWatching(bool watching)
+{
+    if (m_watching == watching) {
+        return;
+    }
+
+    // While not watching, the windows are left alone: those that can't be seen get
+    // no frame callbacks on our account and are free to stop drawing.
+    m_watching = watching;
+    for (Window *window : std::as_const(m_windows)) {
+        if (watching) {
+            watch(window);
+        } else {
+            unwatch(window);
+        }
+    }
+    if (watching) {
+        Q_EMIT frame();
+    }
 }
 
 void DesktopScreenCastSource::scheduleFrame()
 {
-    if (m_active && !isHeldBack()) {
+    if (m_watching) {
         Q_EMIT frame();
     }
 }
@@ -302,14 +359,8 @@ std::chrono::nanoseconds DesktopScreenCastSource::clock() const
 
 void DesktopScreenCastSource::pause()
 {
-    if (!m_active) {
-        return;
-    }
-
-    for (Window *window : std::as_const(m_windows)) {
-        unwatch(window);
-    }
     m_active = false;
+    setWatching(false);
 }
 
 void DesktopScreenCastSource::resume()
@@ -318,12 +369,12 @@ void DesktopScreenCastSource::resume()
         return;
     }
 
-    for (Window *window : std::as_const(m_windows)) {
-        watch(window);
-    }
     m_active = true;
-
-    Q_EMIT frame();
+    setWatching(!m_suspended);
+    if (!m_watching) {
+        // Something to show until we are watching again
+        Q_EMIT frame();
+    }
 }
 
